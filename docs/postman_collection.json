              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Sample Book\",\n  \"author\": \"Sample Author\",\n  \"isbn\": \"9781000009002\",\n  \"totalCopies\": 3,\n  \"genreId\": {{genreId}},\n  \"description\": \"Created from the Postman collection.\"\n}",
