// Library Management System: data model
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATRON
  LIBRARIAN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  // bcrypt hash, never the plain password.
  password  String
  role      Role     @default(PATRON)
  createdAt DateTime @default(now())

  reviews  Review[]
  bookings Booking[]
}

model Genre {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  // URL-friendly version of the name, e.g. "science-fiction".
  slug        String  @unique
  description String?

  books Book[]
}

model Book {
  id              Int      @id @default(autoincrement())
  title           String
  author          String
  isbn            String   @unique
  description     String?
  publishedYear   Int?
  totalCopies     Int      @default(1)
  availableCopies Int      @default(1)
  createdAt       DateTime @default(now())

  // Each book belongs to exactly one genre, stored as a foreign key.
  genreId Int
  genre   Genre @relation(fields: [genreId], references: [id])

  reviews Review[]

  @@unique([title, author])
  @@index([genreId])
}

// Stretch: a patron's rating and comment on a book.
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int // 1 to 5, checked in application code
  comment   String?
  createdAt DateTime @default(now())

  bookId Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One review per user per book.
  @@unique([bookId, userId])
  @@index([userId])
}

// A room or area that can be booked, e.g. "Study Room A".
model Space {
  id       Int    @id @default(autoincrement())
  name     String @unique
  capacity Int

  bookings Booking[]
}

// A patron's reservation of a space for one time slot on one day.
// startTime and endTime are 24-hour "HH:MM" strings (zero-padded, so they sort correctly as text).
model Booking {
  id        Int           @id @default(autoincrement())
  date      DateTime      @db.Date
  startTime String
  endTime   String
  // Cancelling keeps the row (status CANCELLED) so there is a record of it, and frees the slot.
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())

  spaceId Int
  space   Space @relation(fields: [spaceId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The conflict check looks up bookings by space and date.
  @@index([spaceId, date])
  @@index([userId])
}
